# Copiar a .env para desarrollo local. No subir .env al repositorio.

HTTP_ADDR=:8080
# Formato del driver o URL mysql://usuario:clave@host:puerto/base
MYSQL_DSN=sentrya:sentrya@tcp(localhost:3306)/iot_monitoring
# "", "true", "skip-verify" o "preferred"
MYSQL_TLS=

# Vacío desactiva MQTT. Con TLS: ssl://host:8883
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_TOPIC=sentrya/+/+/readings
MQTT_CLIENT_ID=sentrya-iot-monitoring
MQTT_USERNAME=
MQTT_PASSWORD=

# El mismo authorization.jwt.secret de IAM. En local se puede omitir con AUTH_DISABLED=true.
JWT_SECRET=
AUTH_DISABLED=true
CORS_ALLOWED_ORIGINS=*

# Sin SMTP_HOST las alertas solo se registran en el log.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alertas@sentrya.local
ALERT_RECIPIENT=
